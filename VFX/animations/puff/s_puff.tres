code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform sampler2D tex_vtx_8;



void vertex() {
// Input:2
	vec3 n_out2p0 = VERTEX;


// Input:11
	float n_out11p0 = TIME;


// Vector2Constant:13
	vec2 n_out13p0 = vec2(0.100000, 1.000000);


// VectorOp:12
	vec2 n_out12p0 = vec2(n_out11p0) * n_out13p0;


// UVFunc:10
	vec2 n_in10p1 = vec2(1.00000, 1.00000);
	vec2 n_out10p0 = n_out12p0 * n_in10p1 + UV;


// Texture2D:8
	vec4 n_out8p0 = texture(tex_vtx_8, n_out10p0);
	float n_out8p1 = n_out8p0.r;


// Input:4
	vec3 n_out4p0 = NORMAL;


// VectorOp:9
	vec3 n_out9p0 = vec3(n_out8p1) * n_out4p0;


// FloatConstant:7
	float n_out7p0 = -0.600000;


// VectorOp:6
	vec3 n_out6p0 = n_out9p0 * vec3(n_out7p0);


// VectorOp:5
	vec3 n_out5p0 = n_out2p0 + n_out6p0;


// Output:0
	VERTEX = n_out5p0;


}

void fragment() {
// Input:2
	vec4 n_out2p0 = COLOR;
	float n_out2p4 = n_out2p0.a;


// Output:0
	ALBEDO = vec3(n_out2p0.xyz);
	ALPHA = n_out2p4;


}

void light() {
// Input:2
	vec3 n_out2p0 = NORMAL;


// Fresnel:4
	float n_in4p3 = 1.00000;
	float n_out4p0 = pow(clamp(dot(NORMAL, VIEW), 0.0, 1.0), n_in4p3);


// DotProduct:3
	float n_out3p0 = dot(n_out2p0, vec3(n_out4p0));


// Output:0
	DIFFUSE_LIGHT = vec3(n_out3p0);


}
